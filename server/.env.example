# MediMate AI - Server Environment Configuration

# Server Port
PORT=5001

# Google Gemini API Key (Get yours from Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=

# Configurable Gemini Model Name (can be changed without touching application code)
# Options: gemini-2.5-flash, gemini-2.0-flash, gemini-1.5-flash, gemini-2.5-pro
GEMINI_MODEL=gemini-2.5-flash

# Configurable Regional Language (ISO 639-1 code and display name)
# Supported: hi (Hindi), mr (Marathi), ta (Tamil), te (Telugu), bn (Bengali), kn (Kannada), gu (Gujarati)
DEFAULT_REGIONAL_LANGUAGE=mr
DEFAULT_REGIONAL_LANGUAGE_NAME=Marathi (मराठी)

# Security and Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30
REQUEST_TIMEOUT_MS=25000
